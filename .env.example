# Copy to .env for local development. Never commit real secrets.
SERVER_PORT=8080
LLM_PROVIDER=google-gemini
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com
LLM_MODEL=gemini-3.8-flash
LLM_API_VERSION=v1beta
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.0
LLM_EXTRACTION_PROMPT_VERSION=v1
LLM_EXTRACTION_SCHEMA_VERSION=v1
PDF_TEMPLATE_VERSION=v1
MAX_IMAGE_SIZE_BYTES=10485760
MAX_SUPPORTING_DOCUMENT_SIZE_BYTES=15728640
